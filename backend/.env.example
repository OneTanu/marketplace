# Production settings for the Django API and worker (config.settings.prod).
# Copy to backend/.env.production (gitignored) and fill in real values there. Never commit
# real values: this file only documents the names.

DJANGO_SETTINGS_MODULE=config.settings.prod
# A long random string: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The API's public host names, comma-separated (e.g. api.tanu.one).
DJANGO_ALLOWED_HOSTS=
# The web app's origin, trusted for CSRF and used in emailed links (e.g. https://tanu.one).
WEB_APP_URL=

# Supabase Postgres (Project → Connect). Both include the database password, so a password
# with special characters must be percent-encoded (@ -> %40, / -> %2F, : -> %3A, # -> %23).
# Transaction pooler, port 6543: the API's connection.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session pooler, port 5432: migrations and the Procrastinate worker (they can't use the
# transaction pooler). Use the session pooler rather than the "direct" host, which is IPv6-only
# on Supabase's free plan.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Postmark (Servers → your server → API Tokens): the server token, which sends email.
POSTMARK_SERVER_TOKEN=
# The sender students see. Its domain must be verified in Postmark (Sender Signatures).
DEFAULT_FROM_EMAIL=Tanu <no-reply@tanu.one>
